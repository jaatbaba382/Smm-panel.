<!DOCTYPE html>
<html>
<head>
  <title>SMM Panel</title>
</head>
<body>
  <h1>Welcome to Your SMM Panel</h1>
  <p id="userEmail">Loading...</p>
  <button onclick="logout()">Logout</button>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
    import { getAuth, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";

    const firebaseConfig = {
      apiKey: "TERA_API_KEY",
      authDomain: "TERA_PROJECT_ID.firebaseapp.com",
      projectId: "TERA_PROJECT_ID",
      appId: "TERA_APP_ID"
    };

    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);

    onAuthStateChanged(auth, (user) => {
      if (user) {
        document.getElementById("userEmail").textContent = "Logged in as: " + user.email;
      } else {
        window.location.href = "login.html";
      }
    });

    window.logout = function () {
      signOut(auth).then(() => {
        window.location.href = "login.html";
      });
    }
  </script>
</body>
</html>
<!DOCTYPE html>
<html>
<head>
  <title>Add Funds</title>
</head>
<body>
  <h2>Add Funds</h2>
  <p>Send money to this UPI ID: <br><br>tuyoupay@upi</p>
  <input type="text" placeholder="Enter amount sent (₹)" id="amount">
  <input type="text" placeholder="Enter UPI Transaction ID" id="txnId">
  <button id="submitBtn">Submit Request</button>

  <!-- Firebase SDKs -->
  <script src="https://www.gstatic.com/firebasejs/9.22.2/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.22.2/firebase-database-compat.js"></script>

  <script>
    // Firebase config
    const firebaseConfig = {
      apiKey: "AIzaSyCCm6KVhCwtAnVCoHZv9C86mfFNeDNHKdE",
      authDomain: "smm-panel-1c7c4.firebaseapp.com",
      databaseURL: "https://smm-panel-1c7c4-default-rtdb.firebaseio.com",
      projectId: "smm-panel-1c7c4",
      storageBucket: "smm-panel-1c7c4.firebasestorage.app",
      messagingSenderId: "474222165775",
      appId: "1:474222165775:web:3a9153a37dc4632bb2087a",
      measurementId: "G-SSXDH00LPF"
    };

    // Initialize Firebase
    firebase.initializeApp(firebaseConfig);
    const db = firebase.database();

    // Submit function
    document.getElementById("submitBtn").addEventListener("click", () => {
      const amount = document.getElementById("amount").value;
      const txnId = document.getElementById("txnId").value;

      if (amount && txnId) {
        db.ref("fundRequests").push({
          amount: amount,
          transactionId: txnId,
          timestamp: Date.now()
        }).then(() => {
          alert("Request Submitted Successfully!");
        }).catch((error) => {
          alert("Error: " + error.message);
        });
      } else {
        alert("Please fill in both fields.");
      }
    });
  </script>
</body>
</html>
